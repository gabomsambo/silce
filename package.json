{
  "name": "silver-pineapple-website",
  "version": "1.0.0",
  "description": "Boutique short-term rental website for Silver Pineapple properties in Melbourne, FL",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "next lint",
    "check:icons": "node scripts/check-icons.mjs",
    "check:links": "node scripts/check-links.mjs",
    "start": "next start",
    "pages:build": "opennextjs-cloudflare build && mv .open-next/worker.js .open-next/_worker.js && mv .open-next/assets/_next .open-next/_next && cp -r .open-next/assets/* .open-next/ && rm -rf .open-next/assets && cp .claude/routes.json .open-next/_routes.json",
    "pages:dev": "npm run pages:build && wrangler pages dev .open-next --compatibility-date=2024-09-23 --compatibility-flag=nodejs_compat",
    "preview": "npm run pages:build && opennextjs-cloudflare preview",
    "deploy": "npm run pages:build && wrangler pages deploy .open-next",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@opennextjs/cloudflare": "1.19.11",
    "@radix-ui/react-slot": "1.1.1",
    "@types/leaflet": "^1.9.20",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "geist": "^1.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "15.5.25",
    "next-intl": "^4.3.12",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}

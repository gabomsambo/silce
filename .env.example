# Site Configuration
NEXT_PUBLIC_SITE_URL=https://silverpineapple.net
NEXT_PUBLIC_SITE_NAME="Silver Pineapple"

# Analytics (Google Analytics 4)
# Empty keeps analytics and the consent bar off (the live site). Setting a real GA4 id
# (e.g. G-XXXXXXXXXX) shows the compact consent bar; GA scripts still load only after
# a visitor clicks "Accept analytics". With no stored choice, or a declined one, no GA
# script runs and no GA cookie is kept.
NEXT_PUBLIC_ANALYTICS_ID=

# Newsletter signup, review notes and contact messages
# RESEND_KEY and TURNSTILE_SECRET_KEY are server-only secrets for
# functions/api/newsletter, reviews and contact (server/*.ts). Register each
# deployed hostname in the Turnstile widget configuration.
RESEND_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SEO Verification Tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Hospitable Configuration
NEXT_PUBLIC_HOSPITABLE_ACCOUNT_ID=your-hospitable-account-id
NEXT_PUBLIC_HOSPITABLE_WIDGET_URL=your-hospitable-widget-url

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=your-email@domain.com

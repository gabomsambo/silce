# Site Configuration
NEXT_PUBLIC_SITE_URL=https://silverpineapple.net
NEXT_PUBLIC_SITE_NAME="Silver Pineapple"

# Analytics (Google Analytics 4)
# Setting this alone does not enable tracking: the GA scripts load only after a visitor
# accepts analytics cookies in the consent banner. With no stored choice, or a declined
# one, no GA script runs and no GA cookie is kept.
NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Newsletter signup
# RESEND_KEY and TURNSTILE_SECRET_KEY are server-only secrets. Register each
# deployed hostname in the Turnstile widget configuration.
RESEND_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SEO Verification Tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Hospitable Configuration
NEXT_PUBLIC_HOSPITABLE_ACCOUNT_ID=your-hospitable-account-id
NEXT_PUBLIC_HOSPITABLE_WIDGET_URL=your-hospitable-widget-url

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=your-email@domain.com
